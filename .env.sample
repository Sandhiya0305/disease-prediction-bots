# .env.sample – Copy to .env and fill your values
# cp .env.sample .env  (PowerShell: Copy-Item .env.sample .env)
# Never commit .env – it is gitignored via .gitignore:26

# ── Google Gemini API Key ──────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
# main.py:34 accepts API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY
API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"  # alternative name
# GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"  # alternative name

# ── Twilio (for WhatsApp) ──────────────────────────────────────────
# Find in https://www.twilio.com/console
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# Your Twilio WhatsApp sender – format must be whatsapp:+<E.164>
# Sandbox (free, no approval): whatsapp:+14155238886
# Your approved sender (if onboarded): whatsapp:+918608632417
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# ── ngrok (for exposing localhost to phone/WhatsApp) ───────────────
# Get from https://dashboard.ngrok.com/get-started/your-authtoken (free signup)
# ngrok v3 requires this – either set here + export, or run `ngrok config add-authtoken`
# Option A – env var (recommended for env-based setup, avoids config file):
NGROK_AUTHTOKEN="2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Usage:
#   PowerShell per-session:  $env:NGROK_AUTHTOKEN="2_xxx"; ngrok http 8000
#   Persistent (User):       [Environment]::SetEnvironmentVariable("NGROK_AUTHTOKEN","2_xxx","User")
#   Inline:                  ngrok http 8000 --authtoken $env:NGROK_AUTHTOKEN
#   From .env file:          Get-Content .env | ForEach-Object { if($_ -match "NGROK_AUTHTOKEN"){ $k,$v=$_ -split "=",2; $env:NGROK_AUTHTOKEN=$v.Trim('"').Trim("'") } }; ngrok http 8000
# Option B – config file:    ngrok config add-authtoken 2_xxx
